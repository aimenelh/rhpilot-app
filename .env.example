# Base de données (hébergement Postgres UE recommandé, ex. Neon région EU)
DATABASE_URL="postgresql://user:password@host:5432/rhpilot"

# Clerk (fournisseur d'identité managé — voir dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Resend (envoi d'email transactionnel — voir resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="RH Pilot <notifications@votredomaine.fr>"

# Adresse canonique utilisée dans les liens des emails et les retours Stripe.
# En production RH Pilot retombe aussi sur https://www.rhpilot.fr si ces valeurs
# sont absentes ; gardez-les tout de même explicites dans Vercel.
APP_URL="http://localhost:3000"

# DSN — clé AES-256-GCM dédiée au chiffrement des NIR stockés pour la préparation DSN.
# OBLIGATOIRE dès que la DSN est utilisée. Générer 32 octets aléatoires et les encoder en
# base64. Ne jamais réutiliser DOCUMENT_ENCRYPTION_KEY.
# Exemple de génération locale : openssl rand -base64 32
DSN_PII_ENCRYPTION_KEY="base64_32_octets_a_remplacer"

# Chiffrement au repos des documents (justificatifs, bulletins, coffre-fort, pièces jointes).
# OBLIGATOIRE en production : sans clé, RH Pilot refuse désormais toute nouvelle écriture
# documentaire au lieu de stocker silencieusement le contenu en clair.
# 32 octets en base64 (openssl rand -base64 32). À sauvegarder : sans elle, les documents
# chiffrés deviennent illisibles. Les anciens documents legacy en clair restent lisibles.
DOCUMENT_ENCRYPTION_KEY="base64_32_octets_a_remplacer"

# Cron Vercel : protège /api/cron/reminders. Au moins 16 caractères, sinon le cron est refusé.
# Exemple : openssl rand -hex 32
CRON_SECRET="secret_long_aleatoire_d_au_moins_16_caracteres"

# Copilote RH Pilot (Anthropic)
ANTHROPIC_API_KEY="sk-ant_..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_BASE="price_..."
STRIPE_PRICE_ID_PER_EMPLOYEE="price_..."

# URL publique utilisée par Stripe pour les retours checkout/portail.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Paie en accès anticipé : identifiants d'organisation RH Pilot autorisés (séparés par des
# virgules). Jamais de SIRET. PAYROLL_ENABLED_FOR_ALL=true ouvre la paie à toutes les organisations.
PAYROLL_PREVIEW_ORGANIZATIONS=""
PAYROLL_ENABLED_FOR_ALL="false"

# Mentions légales : téléphone de l'éditeur, et de l'hébergeur une fois vérifié auprès de lui.
RH_PILOT_CONTACT_PHONE=""
RH_PILOT_HOST_PHONE=""

# Migrations lors d'un déploiement de prévisualisation Vercel (base distincte uniquement).
ALLOW_PREVIEW_MIGRATIONS="false"
