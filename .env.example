# Base de données (hébergement Postgres UE recommandé, ex. Neon région EU)
DATABASE_URL="postgresql://user:password@host:5432/rhpilot"

# Clerk (fournisseur d'identité managé — voir dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Resend (envoi d'email transactionnel — voir resend.com)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="RH Pilot <notifications@votredomaine.fr>"

# Adresse de base utilisée dans les liens des emails envoyés.
# En local, mettez votre adresse ngrok active pour que les liens
# fonctionnent réellement quand vous cliquez depuis votre boîte mail.
APP_URL="http://localhost:3000"

# DSN — clé AES-256-GCM dédiée au chiffrement des NIR stockés pour la préparation DSN.
# Générer 32 octets aléatoires et les encoder en base64. Ne jamais réutiliser une clé publique.
# Exemple de génération locale : openssl rand -base64 32
DSN_PII_ENCRYPTION_KEY="base64_32_octets_a_remplacer"


# Cron Vercel — protège /api/cron/reminders.
# Générer une valeur longue et aléatoire.
CRON_SECRET="secret_long_aleatoire"

# Copilote RH Pilot (Anthropic)
ANTHROPIC_API_KEY="sk-ant_..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_BASE="price_..."
STRIPE_PRICE_ID_PER_EMPLOYEE="price_..."

# URL publique utilisée par Stripe pour les retours checkout/portail.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
