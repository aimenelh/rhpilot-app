// ============================================================
// RH Pilot — Schéma de données MVP (v4)
// ============================================================
// Le référentiel conventionnel est versionné et séparé des règles
// de paie. Aucune règle sociale ou juridique n'est déduite par l'IA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  siret                 String?
  conventionCollective  String?
  collectiveAgreementId String?
  payrollAddress        String?
  payrollPostalCode     String?
  payrollCity           String?
  payrollNafCode        String?
  payrollUrssafReference String?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  subscriptionStatus    String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  memberships             Membership[]
  employees               Employee[]
  employeeEvents          EmployeeEvent[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  invitations             Invitation[]
  taskTemplateOverrides   TaskTemplateOverride[]
  reminderRules           ReminderRule[]
  anomalyDismissals       AnomalyDismissal[]
  collectiveAgreement     CollectiveAgreement? @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict)

  @@index([collectiveAgreementId])
  @@map("organizations")
}

model Invitation {
  id              String     @id @default(cuid())
  organizationId  String
  email           String
  accessRole      AccessRole
  token           String     @unique
  createdByUserId String
  createdAt       DateTime   @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@map("invitations")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  firstName      String?
  lastName       String?
  authProviderId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  memberships       Membership[]
  auditLogs         AuditLog[]
  anomalyDismissals AnomalyDismissal[]
  sentNotifications Notification[]
  @@map("users")
}

enum AccessRole {
  OWNER
  ADMIN
  MEMBER
}

enum FunctionalRole {
  RH
  DIRIGEANT
}

enum NotificationFrequency {
  DAILY
  WEEKLY
  OFF
}

model Membership {
  id                    String                @id @default(cuid())
  userId                String
  organizationId        String
  accessRole            AccessRole
  functionalRole        FunctionalRole?
  notificationFrequency NotificationFrequency @default(DAILY)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  managedEmployees      Employee[]     @relation("EmployeeManager")
  assignedTasks         Task[]
  uploadedAttachments   Attachment[]
  receivedNotifications Notification[]
  @@unique([userId, organizationId])
  @@unique([organizationId, id])
  @@index([organizationId, functionalRole])
  @@map("memberships")
}

enum ContractType {
  CDI
  CDD
  APPRENTISSAGE
  PROFESSIONNALISATION
}

enum Civility {
  MME
  M
  AUTRE
}

enum DurationUnit {
  DAYS
  WEEKS
  MONTHS
}

enum ProfessionalCategory {
  CADRE
  AGENT_DE_MAITRISE
  EMPLOYE
  OUVRIER
  AUTRE
}

model Employee {
  id                      String        @id @default(cuid())
  organizationId          String
  firstName               String
  lastName                String
  civility                Civility?
  position                String?
  professionalCategory    ProfessionalCategory?
  hireDate                DateTime
  contractType            ContractType?
  contractEndDate         DateTime?
  probationDuration       Int?
  probationDurationUnit   DurationUnit?
  nextMedicalVisitDate    DateTime?
  managerMembershipId     String?
  isDemoData              Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  managerMembership Membership?  @relation("EmployeeManager", fields: [organizationId, managerMembershipId], references: [organizationId, id], onDelete: Restrict)
  events            EmployeeEvent[]
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("employees")
}

model EventTemplate {
  id          String    @id @default(cuid())
  key         String    @unique
  label       String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  taskTemplates  TaskTemplate[]
  employeeEvents EmployeeEvent[]
  @@map("event_templates")
}

enum FunctionalRoleResolution {
  RH
  DIRIGEANT
  MANAGER_DIRECT
}

enum DeadlineType {
  LEGAL_DEADLINE
  ORGANIZATIONAL_DEFAULT
  USER_DEFINED
}

enum OverrideAction {
  MODIFIED
  REMOVED
}

model TaskTemplateOverride {
  id             String         @id @default(cuid())
  organizationId String
  taskTemplateId String
  action         OverrideAction
  label          String?
  dueOffsetDays  Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Restrict)
  @@unique([organizationId, taskTemplateId])
  @@index([organizationId])
  @@map("task_template_overrides")
}

model TaskTemplate {
  id                    String                   @id @default(cuid())
  key                   String                   @unique
  eventTemplateId       String
  label                 String
  stepOrder             Int
  dueOffsetDays         Int
  deadlineType          DeadlineType             @default(ORGANIZATIONAL_DEFAULT)
  defaultFunctionalRole FunctionalRoleResolution
  proofRequired         Boolean                  @default(false)
  proofLabel            String?
  archivedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  eventTemplate EventTemplate @relation(fields: [eventTemplateId], references: [id], onDelete: Restrict)
  tasks         Task[]
  overrides     TaskTemplateOverride[]
  @@index([eventTemplateId])
  @@map("task_templates")
}

model EmployeeEvent {
  id              String    @id
  organizationId  String
  employeeId      String
  eventTemplateId String
  triggerDate     DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee      Employee      @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  eventTemplate EventTemplate @relation(fields: [eventTemplateId], references: [id], onDelete: Restrict)
  tasks         Task[]
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([employeeId])
  @@map("employee_events")
}

enum TaskStatus {
  TO_PREPARE
  TODO
  IN_PROGRESS
  WAITING_EXTERNAL
  DONE
  CANCELLED
}

model Task {
  id                   String                   @id @default(cuid())
  organizationId       String
  employeeEventId      String
  taskTemplateId       String?
  label                String
  stepOrder             Int
  dueDate               DateTime
  deadlineType          DeadlineType
  resolutionRole        FunctionalRoleResolution
  assignedMembershipId String?
  status               TaskStatus               @default(TO_PREPARE)
  completedAt           DateTime?
  proofRequired         Boolean                  @default(false)
  proofLabel            String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  employeeEvent      EmployeeEvent  @relation(fields: [organizationId, employeeEventId], references: [organizationId, id], onDelete: Cascade)
  taskTemplate       TaskTemplate?  @relation(fields: [taskTemplateId], references: [id], onDelete: Restrict)
  assignedMembership Membership?    @relation(fields: [organizationId, assignedMembershipId], references: [organizationId, id], onDelete: Restrict)
  attachments        Attachment[]
  @@unique([organizationId, id])
  @@index([employeeEventId])
  @@index([assignedMembershipId])
  @@index([status, dueDate])
  @@map("tasks")
}

model Attachment {
  id                     String   @id @default(cuid())
  organizationId         String
  taskId                 String
  storageKey              String
  fileName               String?
  mimeType               String
  sizeBytes              Int
  uploadedByMembershipId String?
  createdAt              DateTime @default(now())
  task                 Task        @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)
  uploadedByMembership Membership? @relation(fields: [organizationId, uploadedByMembershipId], references: [organizationId, id], onDelete: Restrict)
  @@index([taskId])
  @@map("attachments")
}

model ReminderRule {
  id             String   @id @default(cuid())
  organizationId String
  daysBeforeDue  Int
  notifyAssignee Boolean  @default(true)
  notifyManager  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, daysBeforeDue])
  @@index([organizationId])
  @@map("reminder_rules")
}

model Notification {
  id                    String   @id @default(cuid())
  organizationId        String
  recipientMembershipId String
  type                  String
  subject               String
  taskId                String?
  employeeEventId       String?
  sentByUserId          String?
  delivered             Boolean  @default(true)
  sentAt                DateTime @default(now())
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipientMembership  Membership   @relation(fields: [organizationId, recipientMembershipId], references: [organizationId, id], onDelete: Restrict)
  sentByUser            User?        @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, sentAt])
  @@map("notifications")
}

model AnomalyDismissal {
  id                String    @id
  organizationId    String
  anomalyKey        String
  snoozedUntil      DateTime?
  dismissedByUserId String?
  createdAt         DateTime  @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dismissedBy  User?        @relation(fields: [dismissedByUserId], references: [id], onDelete: SetNull)
  @@unique([organizationId, anomalyKey])
  @@index([organizationId])
  @@map("anomaly_dismissals")
}

model AuditLog {
  id             String   @id
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model DiagnosticResponse {
  id          String   @id
  answers     Json
  riskAreas   String[]
  email       String?
  companySize String?
  createdAt   DateTime @default(now())
  @@index([createdAt])
  @@map("diagnostic_responses")
}

model CollectiveAgreement {
  id         String   @id
  idcc       String
  name       String
  sourceName String?
  sourceUrl  String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  organizations   Organization[]
  versions        CollectiveAgreementVersion[]
  payrollProfiles PayrollProfile[]
  @@unique([idcc])
  @@map("collective_agreements")
}

model CollectiveAgreementVersion {
  id                    String   @id
  collectiveAgreementId String
  version               Int
  validFrom             DateTime @db.Date
  validUntil            DateTime? @db.Date
  sourceName            String
  sourceUrl             String?
  sourceReference       String?
  status                String   @default("DRAFT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  collectiveAgreement CollectiveAgreement @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict)
  rules                CollectiveAgreementRule[]
  @@unique([collectiveAgreementId, version])
  @@index([collectiveAgreementId, validFrom, validUntil, status])
  @@map("collective_agreement_versions")
}

model CollectiveAgreementRule {
  id              String   @id
  versionId       String
  code            String
  category        String
  parameters      Json
  sourceReference String
  sourceUrl       String?
  validFrom       DateTime @db.Date
  validUntil      DateTime? @db.Date
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version CollectiveAgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  @@unique([versionId, code])
  @@index([versionId, category, validFrom, validUntil, status])
  @@map("collective_agreement_rules")
}

model PayrollProfile {
  id                    String   @id
  organizationId        String
  employeeId            String
  payFrequency          String   @default("MONTHLY")
  currency              String   @default("EUR")
  baseSalaryCents       Int?
  monthlyHours          Decimal? @db.Decimal(8, 2)
  collectiveAgreementId String?
  classificationCode    String?
  classificationLabel   String?
  employeeAddress       String?
  level                 String?
  coefficient            String?
  seniorityDate         DateTime?
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  collectiveAgreement CollectiveAgreement? @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict)
  @@unique([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, employeeId])
  @@index([collectiveAgreementId])
  @@map("payroll_profiles")
}

model PayrollPeriod {
  id             String    @id
  organizationId String
  year           Int
  month          Int
  status         String    @default("DRAFT")
  calculatedAt   DateTime?
  validatedAt    DateTime?
  lockedAt       DateTime?
  paymentDate    DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_periods")
}

model PayrollVariable {
  id              String   @id
  organizationId  String
  payrollPeriodId String
  employeeId      String
  code            String
  label           String
  amount          Decimal  @db.Decimal(12, 2)
  unit            String   @default("EUR")
  source          String   @default("MANUAL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([organizationId, payrollPeriodId, employeeId])
  @@map("payroll_variables")
}

model PayrollRuleVersion {
  id         String   @id
  code       String
  version    Int
  scope      String
  validFrom  DateTime @db.Date
  validUntil DateTime? @db.Date
  sourceName String
  sourceUrl  String?
  parameters Json
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([code, version, scope])
  @@index([code, scope, validFrom, validUntil, status])
  @@map("payroll_rule_versions")
}

model PayrollCalculation {
  id                    String   @id
  organizationId        String
  payrollPeriodId       String
  employeeId            String
  ruleSetVersion        String
  grossAmount           Decimal  @db.Decimal(12, 2)
  employeeContributions Decimal  @default(0) @db.Decimal(12, 2)
  employerContributions Decimal  @default(0) @db.Decimal(12, 2)
  netBeforeTax          Decimal  @db.Decimal(12, 2)
  withholdingTax        Decimal  @default(0) @db.Decimal(12, 2)
  netPaid               Decimal  @db.Decimal(12, 2)
  netTaxableAmount      Decimal? @db.Decimal(12, 2)
  netSocialAmount       Decimal? @db.Decimal(12, 2)
  calculationSnapshot   Json
  createdAt             DateTime @default(now())
  @@unique([organizationId, payrollPeriodId, employeeId])
  @@map("payroll_calculations")
}

model PayrollContribution {
  id             String   @id
  calculationId  String
  code           String
  label          String
  side           String
  baseAmount     Decimal  @db.Decimal(12, 2)
  rate           Decimal  @db.Decimal(10, 6)
  amount         Decimal  @db.Decimal(12, 2)
  ruleVersionId  String?
  createdAt      DateTime @default(now())
  @@index([calculationId])
  @@map("payroll_contributions")
}

model Payslip {
  id              String    @id
  organizationId  String
  payrollPeriodId String
  employeeId      String
  calculationId   String
  documentStatus  String    @default("DRAFT")
  storageKey      String?
  generatedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@unique([calculationId])
  @@unique([organizationId, payrollPeriodId, employeeId])
  @@map("payslips")
}
