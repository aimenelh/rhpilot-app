// ============================================================
// RH Pilot — Schéma de données MVP (v4)
// ============================================================
// Le référentiel conventionnel est versionné et séparé des règles
// de paie. Aucune règle sociale ou juridique n'est déduite par l'IA.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String    @id @default(cuid())
  name                  String
  siret                 String?
  conventionCollective  String?
  collectiveAgreementId String?
  payrollAddress        String?
  payrollPostalCode     String?
  payrollCity           String?
  payrollNafCode        String?
  payrollUrssafReference String?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  employees             Employee[]
  collectiveAgreement   CollectiveAgreement? @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict)
  payrollProfiles       PayrollProfile[]
  payrollPeriods        PayrollPeriod[]
  payrollVariables      PayrollVariable[]
  payrollCalculations   PayrollCalculation[]
  payslips              Payslip[]
  auditLogs             AuditLog[]
  @@index([collectiveAgreementId])
  @@map("organizations")
}

model Employee {
  id                   String    @id
  organizationId       String
  firstName            String
  lastName             String
  position             String?
  hireDate             DateTime  @db.Date
  contractType         String?
  professionalCategory String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payrollProfiles      PayrollProfile[]
  payrollVariables     PayrollVariable[]
  payrollCalculations  PayrollCalculation[]
  payslips              Payslip[]
  @@unique([organizationId, id])
  @@index([organizationId, deletedAt])
  @@map("employees")
}

model CollectiveAgreement {
  id          String   @id
  name        String
  idcc        String   @unique
  versions    CollectiveAgreementVersion[]
  payrollProfiles PayrollProfile[]
  organizations Organization[]
  @@map("collective_agreements")
}

model CollectiveAgreementVersion {
  id                    String   @id
  collectiveAgreementId String
  version               Int
  validFrom             DateTime @db.Date
  validUntil            DateTime? @db.Date
  sourceName            String
  sourceUrl             String?
  sourceReference       String?
  status                String   @default("DRAFT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  collectiveAgreement CollectiveAgreement @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict)
  rules                CollectiveAgreementRule[]
  @@unique([collectiveAgreementId, version])
  @@index([collectiveAgreementId, validFrom, validUntil, status])
  @@map("collective_agreement_versions")
}

model CollectiveAgreementRule {
  id              String   @id
  versionId       String
  code            String
  category        String
  parameters      Json
  sourceReference String
  sourceUrl       String?
  validFrom       DateTime @db.Date
  validUntil      DateTime? @db.Date
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  version CollectiveAgreementVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  @@unique([versionId, code])
  @@index([versionId, category, validFrom, validUntil, status])
  @@map("collective_agreement_rules")
}

model Absence {
  id                    String        @id
  organizationId        String
  employeeId            String
  type                  AbsenceType
  startDate             DateTime      @db.Date
  endDate               DateTime      @db.Date
  status                AbsenceStatus @default(TO_VALIDATE)
  justificationRequired Boolean       @default(false)
  payrollImpactStatus   PayrollImpactStatus @default(PENDING)
  notes                 String?
  validatedByUserId     String?
  validatedAt           DateTime?
  rejectedReason        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee           Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  justifications     AbsenceJustification[]
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status])
  @@map("absences")
}

enum AbsenceType { PAID_LEAVE RTT SICK_LEAVE WORK_ACCIDENT UNPAID_LEAVE FAMILY_EVENT OTHER }
enum AbsenceStatus { TO_VALIDATE TO_PROVIDE_JUSTIFICATION TO_REVIEW_JUSTIFICATION VALIDATED REJECTED }
enum JustificationStatus { TO_PROVIDE RECEIVED VALIDATED REJECTED }
enum PayrollImpactStatus { PENDING READY INTEGRATED }

model AbsenceJustification {
  id String @id
  absenceId String
  status JustificationStatus @default(TO_PROVIDE)
  storageKey String?
  fileName String?
  mimeType String?
  sizeBytes Int?
  uploadedByUserId String?
  reviewedByUserId String?
  reviewedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  absence Absence @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("AbsenceJustificationUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("AbsenceJustificationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  @@index([absenceId, status])
  @@index([reviewedByUserId, reviewedAt])
  @@map("absence_justifications")
}

model PayrollProfile {
  id String @id
  organizationId String
  employeeId String
  payFrequency String @default("MONTHLY")
  currency String @default("EUR")
  baseSalaryCents Int?
  monthlyHours Decimal? @db.Decimal(8, 2)
  collectiveAgreementId String?
  classificationCode String?
  classificationLabel String?
  employeeAddress String?
  level String?
  coefficient String?
  seniorityDate DateTime?
  effectiveFrom DateTime
  effectiveUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  collectiveAgreement CollectiveAgreement? @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict)
  @@unique([organizationId, employeeId, effectiveFrom])
  @@index([organizationId, employeeId])
  @@index([collectiveAgreementId])
  @@map("payroll_profiles")
}

model PayrollPeriod {
  id String @id
  organizationId String
  year Int
  month Int
  status String @default("DRAFT")
  calculatedAt DateTime?
  validatedAt DateTime?
  lockedAt DateTime?
  paymentDate DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_periods")
}

model PayrollVariable {
  id String @id
  organizationId String
  payrollPeriodId String
  employeeId String
  code String
  label String
  amount Decimal @db.Decimal(12, 2)
  unit String @default("EUR")
  source String @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, payrollPeriodId, employeeId])
  @@map("payroll_variables")
}

model PayrollRuleVersion {
  id String @id
  code String
  version Int
  scope String
  validFrom DateTime @db.Date
  validUntil DateTime? @db.Date
  sourceName String
  sourceUrl String?
  parameters Json
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([code, version, scope])
  @@index([code, scope, validFrom, validUntil, status])
  @@map("payroll_rule_versions")
}

model PayrollCalculation {
  id String @id
  organizationId String
  payrollPeriodId String
  employeeId String
  ruleSetVersion String
  grossAmount Decimal @db.Decimal(12, 2)
  employeeContributions Decimal @default(0) @db.Decimal(12, 2)
  employerContributions Decimal @default(0) @db.Decimal(12, 2)
  netBeforeTax Decimal @db.Decimal(12, 2)
  withholdingTax Decimal @default(0) @db.Decimal(12, 2)
  netPaid Decimal @db.Decimal(12, 2)
  netTaxableAmount Decimal? @db.Decimal(12, 2)
  netSocialAmount Decimal? @db.Decimal(12, 2)
  calculationSnapshot Json
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  @@unique([organizationId, payrollPeriodId, employeeId])
  @@map("payroll_calculations")
}

model PayrollContribution {
  id String @id
  calculationId String
  code String
  label String
  side String
  baseAmount Decimal? @db.Decimal(12, 2)
  rate Decimal? @db.Decimal(10, 6)
  amount Decimal @db.Decimal(12, 2)
  ruleVersionId String?
  createdAt DateTime @default(now())
  @@index([calculationId])
  @@map("payroll_contributions")
}

model Payslip {
  id String @id
  organizationId String
  payrollPeriodId String
  employeeId String
  calculationId String
  documentStatus String @default("DRAFT")
  storageKey String?
  generatedAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict)
  @@unique([calculationId])
  @@unique([organizationId, payrollPeriodId, employeeId])
  @@map("payslips")
}

model EmployeeWithholdingTaxProfile {
  id String @id
  organizationId String
  employeeId String
  rate Decimal @db.Decimal(8, 6)
  validFrom DateTime @db.Date
  validUntil DateTime? @db.Date
  source String
  sourceReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, employeeId, validFrom, validUntil])
  @@map("employee_withholding_tax_profiles")
}
