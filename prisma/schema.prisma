// ============================================================
// RH Pilot — Schéma de données MVP (v4)
// ============================================================
// Le référentiel conventionnel est versionné et séparé des règles
// de paie. Aucune règle sociale ou juridique n'est déduite par l'IA.
//
// Ce schéma reflète exactement la base de production : plusieurs tables ont été
// créées par des migrations SQL écrites à la main. Il a été resynchronisé par
// introspection (prisma db pull sur une base rejouant toutes les migrations) ;
// `npm run check:schema` vérifie qu'aucun écart ne réapparaît. Sans cela,
// prisma migrate dev proposerait de supprimer des tables et leurs données.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                           String                         @id @default(cuid())
  name                         String
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  deletedAt                    DateTime?
  siret                        String?
  conventionCollective         String?
  collectiveAgreementId        String?
  payrollAddress               String?
  payrollPostalCode            String?
  payrollCity                  String?
  payrollNafCode               String?
  payrollUrssafReference       String?
  legalCategory                String?
  atmpRate                     Decimal?                       @db.Decimal(7, 4)
  companyCreationDate          DateTime?
  payrollDepartment            String?
  healthPlanMonthlyAmount      Decimal?                       @db.Decimal(10, 2)
  healthPlanEmployerRate       Decimal?                       @db.Decimal(5, 2)
  stripeCustomerId             String?                        @unique
  stripeSubscriptionId         String?                        @unique
  subscriptionStatus           String?
  currentPeriodEnd             DateTime?
  payrollHeadcount             Decimal?                       @db.Decimal(10, 2)
  mobilityRate                 Decimal?                       @db.Decimal(6, 3)
  ijssSubrogation              Boolean                        @default(true)
  paidLeaveMethod              String                         @default("OUVRABLES")
  paidLeaveWorkingDays         Json?
  workedSolidarityDay          Boolean                        @default(false)
  sickPayRule                  Json?
  workAccidentPayRule          Json?
  prevoyanceRates              Json?
  mealVoucherFaceValue         Decimal?                       @db.Decimal(8, 2)
  mealVoucherEmployerShare     Decimal?                       @db.Decimal(5, 4)
  transportEmployerShare       Decimal                        @default(0.5) @db.Decimal(5, 4)
  payrollCommuneCode           String?
  registrySyncedAt             DateTime?
  registrySnapshot             Json?
  registryCheckedAt            DateTime?
  mobilityRateSource           String?
  mobilityRateCheckedAt        DateTime?
  mobilityRateDetail           String?
  absences                     Absence[]
  anomalyDismissals            AnomalyDismissal[]
  auditLogs                    AuditLog[]
  dsn_organization_settings    dsn_organization_settings?
  dsn_work_events              dsn_work_events[]
  employee_accounts            employee_accounts[]
  employee_documents           employee_documents[]
  employeeEvents               EmployeeEvent[]
  employee_paid_leave_openings employee_paid_leave_openings[]
  employee_payroll_openings    employee_payroll_openings[]
  employees                    Employee[]
  invitations                  Invitation[]
  memberships                  Membership[]
  notifications                Notification[]
  collectiveAgreement          CollectiveAgreement?           @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict, map: "organizations_collective_agreement_fk")
  payroll_periods              PayrollPeriod[]
  reminderRules                ReminderRule[]
  taskTemplateOverrides        TaskTemplateOverride[]

  @@index([collectiveAgreementId], map: "organizations_collective_agreement_idx")
  @@map("organizations")
}

model Invitation {
  id              String       @id @default(cuid())
  organizationId  String
  email           String
  accessRole      AccessRole
  token           String       @unique
  createdByUserId String
  createdAt       DateTime     @default(now())
  expiresAt       DateTime
  acceptedAt      DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

model User {
  id                            String                 @id @default(cuid())
  email                         String                 @unique
  authProviderId                String?                @unique
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  deletedAt                     DateTime?
  firstName                     String?
  lastName                      String?
  discoveryTourCompletedAt      DateTime?
  reviewedAbsenceJustifications AbsenceJustification[] @relation("AbsenceJustificationReviewedBy")
  uploadedAbsenceJustifications AbsenceJustification[] @relation("AbsenceJustificationUploadedBy")
  validatedAbsences             Absence[]              @relation("AbsenceValidatedBy")
  anomalyDismissals             AnomalyDismissal[]
  auditLogs                     AuditLog[]
  employee_accounts             employee_accounts[]
  memberships                   Membership[]
  sentNotifications             Notification[]

  @@map("users")
}

model Membership {
  id                    String                @id @default(cuid())
  userId                String
  organizationId        String
  accessRole            AccessRole
  functionalRole        FunctionalRole?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  notificationFrequency NotificationFrequency @default(DAILY)
  uploadedAttachments   Attachment[]
  managedEmployees      Employee[]            @relation("EmployeeManager")
  organization          Organization          @relation(fields: [organizationId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id])
  receivedNotifications Notification[]
  assignedTasks         Task[]

  @@unique([userId, organizationId])
  @@unique([organizationId, id])
  @@index([organizationId, functionalRole])
  @@map("memberships")
}

model Employee {
  id                            String                         @id @default(cuid())
  organizationId                String
  firstName                     String
  lastName                      String
  position                      String?
  hireDate                      DateTime
  managerMembershipId           String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  deletedAt                     DateTime?
  contractType                  ContractType?
  nextMedicalVisitDate          DateTime?
  civility                      Civility?
  probationDuration             Int?
  probationDurationUnit         DurationUnit?
  contractEndDate               DateTime?
  professionalCategory          ProfessionalCategory?
  isDemoData                    Boolean                        @default(false)
  personalEmail                 String?
  paperPayslipSince             DateTime?
  paperPayslipSource            String?
  electronicPayslipNoticeAt     DateTime?                      @db.Date
  electronicPayslipNoticeMethod String?
  absences                      Absence[]
  dsn_employee_profiles         dsn_employee_profiles?
  employee_accounts             employee_accounts[]
  employee_documents            employee_documents[]
  events                        EmployeeEvent[]
  employee_paid_leave_openings  employee_paid_leave_openings[]
  employee_payroll_openings     employee_payroll_openings[]
  organization                  Organization                   @relation(fields: [organizationId], references: [id])
  managerMembership             Membership?                    @relation("EmployeeManager", fields: [organizationId, managerMembershipId], references: [organizationId, id])
  payroll_calculations          PayrollCalculation[]
  payroll_entry_reviews         payroll_entry_reviews[]
  payroll_profiles              PayrollProfile[]
  payroll_terminations          payroll_terminations[]
  payroll_variables             PayrollVariable[]
  payslips                      Payslip[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("employees")
}

model EventTemplate {
  id             String          @id @default(cuid())
  key            String          @unique
  label          String
  description    String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  employeeEvents EmployeeEvent[]
  taskTemplates  TaskTemplate[]

  @@map("event_templates")
}

model TaskTemplateOverride {
  id             String         @id @default(cuid())
  organizationId String
  taskTemplateId String
  action         OverrideAction
  label          String?
  dueOffsetDays  Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  taskTemplate   TaskTemplate   @relation(fields: [taskTemplateId], references: [id])

  @@unique([organizationId, taskTemplateId])
  @@index([organizationId])
  @@map("task_template_overrides")
}

model TaskTemplate {
  id                    String                   @id @default(cuid())
  key                   String                   @unique
  eventTemplateId       String
  label                 String
  stepOrder             Int
  dueOffsetDays         Int
  deadlineType          DeadlineType             @default(ORGANIZATIONAL_DEFAULT)
  defaultFunctionalRole FunctionalRoleResolution
  proofRequired         Boolean                  @default(false)
  proofLabel            String?
  archivedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  overrides             TaskTemplateOverride[]
  eventTemplate         EventTemplate            @relation(fields: [eventTemplateId], references: [id])
  tasks                 Task[]

  @@index([eventTemplateId])
  @@map("task_templates")
}

model EmployeeEvent {
  id              String        @id
  organizationId  String
  employeeId      String
  eventTemplateId String
  triggerDate     DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  eventTemplate   EventTemplate @relation(fields: [eventTemplateId], references: [id])
  employee        Employee      @relation(fields: [organizationId, employeeId], references: [organizationId, id])
  organization    Organization  @relation(fields: [organizationId], references: [id])
  tasks           Task[]

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([employeeId])
  @@map("employee_events")
}

model Task {
  id                   String                   @id @default(cuid())
  organizationId       String
  employeeEventId      String
  taskTemplateId       String?
  label                String
  stepOrder            Int
  dueDate              DateTime
  deadlineType         DeadlineType
  resolutionRole       FunctionalRoleResolution
  assignedMembershipId String?
  status               TaskStatus               @default(TO_PREPARE)
  completedAt          DateTime?
  proofRequired        Boolean                  @default(false)
  proofLabel           String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  attachments          Attachment[]
  assignedMembership   Membership?              @relation(fields: [organizationId, assignedMembershipId], references: [organizationId, id])
  employeeEvent        EmployeeEvent            @relation(fields: [organizationId, employeeEventId], references: [organizationId, id], onDelete: Cascade)
  taskTemplate         TaskTemplate?            @relation(fields: [taskTemplateId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([employeeEventId])
  @@index([assignedMembershipId])
  @@index([status, dueDate])
  @@map("tasks")
}

model Attachment {
  id                     String      @id @default(cuid())
  organizationId         String
  taskId                 String
  storageKey             String
  fileName               String?
  mimeType               String
  sizeBytes              Int
  uploadedByMembershipId String?
  createdAt              DateTime    @default(now())
  task                   Task        @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)
  uploadedByMembership   Membership? @relation(fields: [organizationId, uploadedByMembershipId], references: [organizationId, id])

  @@index([taskId])
  @@map("attachments")
}

model ReminderRule {
  id             String       @id @default(cuid())
  organizationId String
  daysBeforeDue  Int
  notifyAssignee Boolean      @default(true)
  notifyManager  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, daysBeforeDue])
  @@index([organizationId])
  @@map("reminder_rules")
}

model Notification {
  id                    String       @id
  organizationId        String
  recipientMembershipId String
  type                  String
  subject               String
  taskId                String?
  employeeEventId       String?
  sentByUserId          String?
  sentAt                DateTime     @default(now())
  delivered             Boolean      @default(true)
  organization          Organization @relation(fields: [organizationId], references: [id])
  recipientMembership   Membership   @relation(fields: [organizationId, recipientMembershipId], references: [organizationId, id])
  sentByUser            User?        @relation(fields: [sentByUserId], references: [id])

  @@index([organizationId, sentAt])
  @@map("notifications")
}

model AnomalyDismissal {
  id                String       @id
  organizationId    String
  anomalyKey        String
  snoozedUntil      DateTime?
  dismissedByUserId String?
  createdAt         DateTime     @default(now())
  dismissedBy       User?        @relation(fields: [dismissedByUserId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, anomalyKey])
  @@index([organizationId])
  @@map("anomaly_dismissals")
}

model AuditLog {
  id             String       @id
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorUserId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model DiagnosticResponse {
  id          String   @id
  answers     Json
  riskAreas   String[]
  email       String?
  companySize String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("diagnostic_responses")
}

model CollectiveAgreement {
  id              String                       @id
  idcc            String                       @unique
  name            String
  sourceName      String?
  sourceUrl       String?
  status          String                       @default("ACTIVE")
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @default(now()) @updatedAt
  versions        CollectiveAgreementVersion[]
  organizations   Organization[]
  payrollProfiles PayrollProfile[]

  @@map("collective_agreements")
}

model CollectiveAgreementVersion {
  id                    String                    @id
  collectiveAgreementId String
  version               Int
  validFrom             DateTime                  @db.Date
  validUntil            DateTime?                 @db.Date
  sourceName            String
  sourceUrl             String?
  sourceReference       String?
  status                String                    @default("DRAFT")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @default(now()) @updatedAt
  rules                 CollectiveAgreementRule[]
  collectiveAgreement   CollectiveAgreement       @relation(fields: [collectiveAgreementId], references: [id], map: "collective_agreement_versions_agreement_fk")

  @@unique([collectiveAgreementId, version], map: "collective_agreement_versions_agreement_version_key")
  @@index([collectiveAgreementId, validFrom, validUntil, status], map: "collective_agreement_versions_lookup_idx")
  @@map("collective_agreement_versions")
}

model CollectiveAgreementRule {
  id              String                     @id
  versionId       String
  code            String
  category        String
  parameters      Json
  sourceReference String
  sourceUrl       String?
  validFrom       DateTime                   @db.Date
  validUntil      DateTime?                  @db.Date
  status          String                     @default("DRAFT")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @default(now()) @updatedAt
  version         CollectiveAgreementVersion @relation(fields: [versionId], references: [id], map: "collective_agreement_rules_version_fk")

  @@unique([versionId, code], map: "collective_agreement_rules_version_code_key")
  @@index([versionId, category, validFrom, validUntil, status], map: "collective_agreement_rules_lookup_idx")
  @@map("collective_agreement_rules")
}

model Absence {
  id                    String                 @id
  organizationId        String
  employeeId            String
  type                  AbsenceType
  startDate             DateTime               @db.Date
  endDate               DateTime               @db.Date
  status                AbsenceStatus          @default(TO_VALIDATE)
  justificationRequired Boolean                @default(false)
  payrollImpactStatus   PayrollImpactStatus    @default(PENDING)
  lastWorkedDate        DateTime?              @db.Date
  subrogationStartDate  DateTime?              @db.Date
  subrogationEndDate    DateTime?              @db.Date
  workAccidentDate      DateTime?              @db.Date
  returnDate            DateTime?              @db.Date
  returnReasonCode      String?
  notes                 String?
  validatedByUserId     String?
  validatedAt           DateTime?
  rejectedReason        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  justifications        AbsenceJustification[]
  employee              Employee               @relation(fields: [organizationId, employeeId], references: [organizationId, id], map: "absences_employee_fkey")
  organization          Organization           @relation(fields: [organizationId], references: [id])
  validatedBy           User?                  @relation("AbsenceValidatedBy", fields: [validatedByUserId], references: [id])
  dsn_work_events       dsn_work_events[]

  @@unique([organizationId, employeeId, id], map: "absences_organization_employee_id_key")
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, employeeId, startDate])
  @@index([organizationId, status])
  @@map("absences")
}

model AbsenceJustification {
  id               String              @id
  absenceId        String
  status           JustificationStatus @default(TO_PROVIDE)
  storageKey       String?
  fileName         String?
  mimeType         String?
  sizeBytes        Int?
  uploadedByUserId String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  absence          Absence             @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  reviewedBy       User?               @relation("AbsenceJustificationReviewedBy", fields: [reviewedByUserId], references: [id])
  uploadedBy       User?               @relation("AbsenceJustificationUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([absenceId, status])
  @@index([reviewedByUserId, reviewedAt])
  @@map("absence_justifications")
}

model PayrollProfile {
  id                      String               @id
  organizationId          String
  employeeId              String
  payFrequency            String               @default("MONTHLY")
  currency                String               @default("EUR")
  baseSalaryCents         Int?
  monthlyHours            Decimal?             @db.Decimal(8, 2)
  collectiveAgreementId   String?
  effectiveFrom           DateTime
  effectiveUntil          DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt
  classificationCode      String?
  classificationLabel     String?
  level                   String?
  coefficient             String?
  seniorityDate           DateTime?
  employeeAddress         String?
  weeklySchedule          Json?
  structuralOvertimeHours Decimal?             @db.Decimal(8, 2)
  structuralOvertimeRate  Decimal?             @db.Decimal(5, 4)
  healthPlanWaiver        Boolean              @default(false)
  collectiveAgreement     CollectiveAgreement? @relation(fields: [collectiveAgreementId], references: [id], onDelete: Restrict, map: "payroll_profiles_collective_agreement_fk")
  employees               Employee             @relation(fields: [organizationId, employeeId], references: [organizationId, id], map: "payroll_profiles_employee_fk")

  @@unique([organizationId, employeeId, effectiveFrom], map: "payroll_profiles_organization_employee_effective_from_key")
  @@index([collectiveAgreementId], map: "payroll_profiles_collective_agreement_idx")
  @@index([organizationId, employeeId], map: "payroll_profiles_organization_employee_idx")
  @@map("payroll_profiles")
}

model PayrollPeriod {
  dsn_declarations dsn_declarations[]
  id                    String                  @id
  organizationId        String
  year                  Int
  month                 Int
  status                String                  @default("DRAFT")
  calculatedAt          DateTime?
  validatedAt           DateTime?
  lockedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  paymentDate           DateTime?               @db.Date
  payroll_calculations  PayrollCalculation[]
  payroll_entry_reviews payroll_entry_reviews[]
  organizations         Organization            @relation(fields: [organizationId], references: [id], map: "payroll_periods_organization_fk")
  payroll_terminations  payroll_terminations[]
  payroll_variables     PayrollVariable[]
  payslips              Payslip[]

  @@unique([organizationId, id], map: "payroll_periods_organization_id_id_key")
  @@unique([organizationId, year, month], map: "payroll_periods_organization_year_month_key")
  @@index([organizationId, status], map: "payroll_periods_organization_status_idx")
  @@map("payroll_periods")
}

model PayrollVariable {
  id              String        @id
  organizationId  String
  payrollPeriodId String
  employeeId      String
  code            String
  label           String
  amount          Decimal       @db.Decimal(12, 2)
  unit            String        @default("EUR")
  source          String        @default("MANUAL")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  reference       String?
  employees       Employee      @relation(fields: [organizationId, employeeId], references: [organizationId, id], map: "payroll_variables_employee_fk")
  payroll_periods PayrollPeriod @relation(fields: [organizationId, payrollPeriodId], references: [organizationId, id], map: "payroll_variables_period_fk")

  @@index([organizationId, payrollPeriodId, employeeId], map: "payroll_variables_period_employee_idx")
  @@map("payroll_variables")
}

model PayrollRuleVersion {
  id                    String                @id
  code                  String
  version               Int
  scope                 String
  validFrom             DateTime              @db.Date
  validUntil            DateTime?             @db.Date
  sourceName            String
  sourceUrl             String?
  parameters            Json
  status                String                @default("DRAFT")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  payroll_contributions PayrollContribution[]

  @@unique([code, version, scope])
  @@index([code, scope, validFrom, validUntil, status], map: "payroll_rule_versions_lookup_idx")
  @@map("payroll_rule_versions")
}

model PayrollCalculation {
  id                     String                   @id
  organizationId         String
  payrollPeriodId        String
  employeeId             String
  ruleSetVersion         String
  grossAmount            Decimal                  @db.Decimal(12, 2)
  employeeContributions  Decimal                  @default(0) @db.Decimal(12, 2)
  employerContributions  Decimal                  @default(0) @db.Decimal(12, 2)
  netBeforeTax           Decimal                  @db.Decimal(12, 2)
  withholdingTax         Decimal                  @default(0) @db.Decimal(12, 2)
  netPaid                Decimal                  @db.Decimal(12, 2)
  calculationSnapshot    Json
  createdAt              DateTime                 @default(now())
  netTaxableAmount       Decimal?                 @db.Decimal(12, 2)
  netSocialAmount        Decimal?                 @db.Decimal(12, 2)
  employees              Employee                 @relation(fields: [organizationId, employeeId], references: [organizationId, id], map: "payroll_calculations_employee_fk")
  payroll_periods        PayrollPeriod            @relation(fields: [organizationId, payrollPeriodId], references: [organizationId, id], map: "payroll_calculations_period_fk")
  payroll_contributions  PayrollContribution[]
  payroll_ledger_entries payroll_ledger_entries[]
  payslips               Payslip?

  @@unique([organizationId, payrollPeriodId, employeeId], map: "payroll_calculations_period_employee_key")
  @@map("payroll_calculations")
}

model PayrollContribution {
  id                    String              @id
  calculationId         String
  code                  String
  label                 String
  side                  String
  baseAmount            Decimal             @db.Decimal(12, 2)
  rate                  Decimal             @db.Decimal(10, 6)
  amount                Decimal             @db.Decimal(12, 2)
  ruleVersionId         String?
  createdAt             DateTime            @default(now())
  payroll_calculations  PayrollCalculation  @relation(fields: [calculationId], references: [id], onDelete: Cascade, map: "payroll_contributions_calculation_fk")
  payroll_rule_versions PayrollRuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict, map: "payroll_contributions_rule_fk")

  @@index([calculationId], map: "payroll_contributions_calculation_idx")
  @@map("payroll_contributions")
}

model Payslip {
  id                   String             @id
  organizationId       String
  payrollPeriodId      String
  employeeId           String
  calculationId        String             @unique(map: "payslips_calculation_key")
  documentStatus       String             @default("DRAFT")
  storageKey           String?
  generatedAt          DateTime?
  publishedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  payroll_calculations PayrollCalculation @relation(fields: [calculationId], references: [id], map: "payslips_calculation_fk")
  employees            Employee           @relation(fields: [organizationId, employeeId], references: [organizationId, id], map: "payslips_employee_fk")
  payroll_periods      PayrollPeriod      @relation(fields: [organizationId, payrollPeriodId], references: [organizationId, id], map: "payslips_period_fk")

  @@unique([organizationId, payrollPeriodId, employeeId], map: "payslips_period_employee_key")
  @@map("payslips")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dsn_employee_profiles {
  id                       String   @id
  organizationId           String
  employeeId               String
  nirCiphertext            String
  birthDate                DateTime @db.Date
  birthPlace               String
  birthDepartment          String
  addressLine              String
  postalCode               String
  city                     String
  countryCode              String?
  contractNumber           String
  contractNatureCode       String
  fixedTermReasonCode      String?
  publicPolicyCode         String   @default("99")
  pcsEsecCode              String
  conventionalStatusCode   String
  retirementStatusCode     String
  workUnitCode             String   @default("10")
  referenceWorkQuota       Decimal  @db.Decimal(8, 2)
  contractWorkQuota        Decimal  @db.Decimal(8, 2)
  workModalityCode         String
  sicknessRegimeCode       String
  oldAgeRegimeCode         String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now())
  birthCountryCode         String?
  euClassificationCode     String?
  baseSchemeSupplementCode String?
  workLocationId           String?
  foreignWorkerCode        String?
  employmentStatusCode     String?
  multipleJobsCode         String?
  multipleEmployersCode    String?
  workAccidentRegimeCode   String?
  workAccidentRiskCode     String?
  complementaryAffiliations Json?
